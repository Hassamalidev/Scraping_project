# Copy to .env and fill in. Never commit .env.

# Postgres (matches docker-compose.yml defaults)
DATABASE_URL=postgresql+psycopg://prodata:prodata@localhost:5440/prodata

# Contact email placed in the crawler User-Agent. Required before collecting.
CONTACT_EMAIL=ops@example.com

# Where the HTTP response cache lives
PRODATA_CACHE_DIR=.cache/http

# Optional: Socrata app token for data.texas.gov (raises rate limits). Free.
SOCRATA_APP_TOKEN=

# Optional paid APIs (Tier 4) — off unless set. Not used yet.
BRAVE_SEARCH_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
ZEROBOUNCE_API_KEY=
